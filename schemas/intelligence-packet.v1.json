{
  "type": "object",
  "required": [
    "schema_version",
    "lab_id",
    "campaign_id",
    "campaign_hash",
    "provider",
    "baseline",
    "certificates",
    "instructions",
    "response_schema"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lab_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_hash": {
      "type": "string"
    },
    "provider": {
      "const": "project_agent"
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ]
    },
    "certificates": {
      "type": "array",
      "minItems": 1
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_schema": {
      "type": "object"
    },
    "candidate_plan_context": {
      "type": "object",
      "required": [
        "catalog_hash",
        "devices",
        "technical_approval"
      ],
      "properties": {
        "catalog_hash": {
          "type": "string"
        },
        "devices": {
          "type": "array"
        },
        "technical_approval": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
