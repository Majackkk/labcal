{
  "type": "object",
  "required": [
    "extraction_id",
    "expected_extraction_hash",
    "origin",
    "author",
    "findings"
  ],
  "properties": {
    "extraction_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_extraction_hash": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "agent_candidate",
        "operator_candidate"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "title",
          "message",
          "basis",
          "suggestion",
          "location"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "required": [
              "page",
              "bbox"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "bbox": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "line_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "quote": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "text",
                  "visual",
                  "section",
                  "document"
                ]
              },
              "markup": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "replace",
                      "delete",
                      "insert",
                      "clarify",
                      "flag"
                    ]
                  },
                  "condition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dimension": {
                    "enum": [
                      "certificate_self",
                      "instrument_requirement",
                      "intended_use"
                    ]
                  },
                  "topic": {
                    "enum": [
                      "general",
                      "uncertainty"
                    ]
                  },
                  "uncertainty_basis": {
                    "type": "object",
                    "required": [
                      "references",
                      "application",
                      "role"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "requirement",
                          "guidance",
                          "supplementary_check"
                        ]
                      },
                      "application": {
                        "type": "string",
                        "minLength": 1
                      },
                      "references": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "document",
                            "clause",
                            "quote",
                            "source",
                            "checked_on",
                            "status"
                          ],
                          "properties": {
                            "document": {
                              "type": "string",
                              "minLength": 1
                            },
                            "clause": {
                              "type": "string",
                              "minLength": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            },
                            "source": {
                              "type": "string",
                              "minLength": 1
                            },
                            "checked_on": {
                              "type": "string",
                              "minLength": 1
                            },
                            "status": {
                              "const": "valid"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "basis_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "source_hash",
                "anchor"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_hash": {
                  "type": "string",
                  "minLength": 1
                },
                "anchor": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
