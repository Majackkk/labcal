{
  "type": "object",
  "required": [
    "review_id",
    "expected_review_hash",
    "finding_id",
    "action",
    "reviewer",
    "reviewed_at",
    "reason"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_review_hash": {
      "type": "string",
      "minLength": 1
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "confirmed",
        "dismissed",
        "resolved"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "bbox"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "line_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quote": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "visual",
              "section",
              "document"
            ]
          },
          "markup": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "replace",
                  "delete",
                  "insert",
                  "clarify",
                  "flag"
                ]
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "enum": [
                  "certificate_self",
                  "instrument_requirement",
                  "intended_use"
                ]
              },
              "topic": {
                "enum": [
                  "general",
                  "uncertainty"
                ]
              },
              "uncertainty_basis": {
                "type": "object",
                "required": [
                  "references",
                  "application",
                  "role"
                ],
                "properties": {
                  "role": {
                    "enum": [
                      "requirement",
                      "guidance",
                      "supplementary_check"
                    ]
                  },
                  "application": {
                    "type": "string",
                    "minLength": 1
                  },
                  "references": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "document",
                        "clause",
                        "quote",
                        "source",
                        "checked_on",
                        "status"
                      ],
                      "properties": {
                        "document": {
                          "type": "string",
                          "minLength": 1
                        },
                        "clause": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source": {
                          "type": "string",
                          "minLength": 1
                        },
                        "checked_on": {
                          "type": "string",
                          "minLength": 1
                        },
                        "status": {
                          "const": "valid"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
