        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "equipment_category": {
            "type": "string",
            "minLength": 1
          },
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "requirement_type": {
            "enum": [
              "mpe",
              "accuracy",
              "resolution",
              "repeatability",
              "class",
              "uncertainty",
              "range",
              "rounding",
              "other"
            ]
          },
          "origin": {
            "enum": [
              "explicit",
              "derived",
              "recommendation"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "range_text": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "state": {
            "enum": [
              "candidate",
              "page_checked",
              "ambiguous"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "page",
                "quote",
                "clause"
              ],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "clause": {
                  "type": "string",
                  "minLength": 1
                },
                "image_sha256": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "criterion": {
            "type": "object",
            "required": [
              "operator",
              "unit",
              "relative_basis"
            ],
            "properties": {
              "operator": {
                "enum": [
                  "abs_le",
                  "le",
                  "ge",
                  "eq",
                  "none"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "relative_basis": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object"
              },
              "constants": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
