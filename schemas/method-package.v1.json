  "required": [
    "standard_code",
    "edition",
    "title",
    "source_id",
    "author",
    "coverage",
    "requirements",
    "gaps"
  ],
  "properties": {
    "standard_code": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "equipment_category",
          "parameter",
          "requirement_type",
          "origin",
          "statement",
          "range_text",
          "condition",
          "state",
          "evidence",
          "criterion"
