{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "lab_id",
    "source_id",
    "source_hash",
    "parser",
    "sheets",
    "candidates",
    "mapping",
    "technical_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lab_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parser": {
      "type": "string",
      "minLength": 1
    },
    "sheets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "mapping": {
      "type": "object"
    },
    "technical_review": {
      "const": "pending"
    }
  },
  "additionalProperties": false
}
