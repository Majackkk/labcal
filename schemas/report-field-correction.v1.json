{
  "type": "object",
  "required": [
    "field",
    "value",
    "reason",
    "location",
    "expected_fields_hash"
  ],
  "properties": {
    "field": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "string",
      "maxLength": 4000
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "required": [
        "page",
        "bbox"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "line_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quote": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "visual",
            "section",
            "document"
          ]
        },
        "markup": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "enum": [
                "replace",
                "delete",
                "insert",
                "clarify",
                "flag"
              ]
            },
            "condition": {
              "type": "string",
              "minLength": 1
            },
            "dimension": {
              "enum": [
                "certificate_self",
                "instrument_requirement",
                "intended_use"
              ]
            },
            "topic": {
              "enum": [
                "general",
                "uncertainty"
              ]
            },
            "uncertainty_basis": {
              "type": "object",
              "required": [
                "references",
                "application",
                "role"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "requirement",
                    "guidance",
                    "supplementary_check"
                  ]
                },
                "application": {
                  "type": "string",
                  "minLength": 1
                },
                "references": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "document",
                      "clause",
                      "quote",
                      "source",
                      "checked_on",
                      "status"
                    ],
                    "properties": {
                      "document": {
                        "type": "string",
                        "minLength": 1
                      },
                      "clause": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "checked_on": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "const": "valid"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "expected_fields_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
