{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "sha256",
    "kind",
    "name",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "object_path": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "absolute_path": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
